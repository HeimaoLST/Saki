+package ui
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/egoist/mygo/internal/platform"
+)
+
+func TestEditorSelectionReleaseBeforeFrame(t *testing.T) {
+	texts := []struct {
+		name      string
+		value     string
+		multiline bool
+	}{
+		{"single", "中文内容 abcdefghijklmnopqrstuvwxyz", false},
+		{"multiline", "第一行中文 abc\n第二行跨行内容 xyz", true},
+	}
+	scenarios := []string{"same-batch", "down-frame", "down-move-frame", "all-frames"}
+	for _, tc := range texts {
+		tc := tc
+		for _, reverse := range []bool{false, true} {
+			for _, scenario := range scenarios {
+				tc := tc
+				reverse, scenario := reverse, scenario
+				t.Run(tc.name+"/"+scenario+"/"+map[bool]string{false: "forward", true: "reverse"}[reverse], func(t *testing.T) {
+					value := tc.value
+					controlAnchor, controlCaret, controlText := runEditorSelection(t, tc.multiline, value, reverse, "all-frames")
+					if controlAnchor == controlCaret || controlText == "" {
+						t.Fatalf("control selection empty anchor=%d caret=%d text=%q", controlAnchor, controlCaret, controlText)
+					}
+					if tc.multiline != strings.Contains(controlText, "\n") {
+						t.Fatalf("control text newline mismatch multiline=%v text=%q", tc.multiline, controlText)
+					}
+					anchor, caret, text := runEditorSelection(t, tc.multiline, value, reverse, scenario)
+					if anchor != controlAnchor || caret != controlCaret || text != controlText {
+						t.Fatalf("scenario %s differs from same-coordinate control: got anchor=%d caret=%d text=%q; want anchor=%d caret=%d text=%q",
+							scenario, anchor, caret, text, controlAnchor, controlCaret, controlText)
+					}
+				})
+			}
+		}
+	}
+}
+
+func runEditorSelection(t *testing.T, multiline bool, value string, reverse bool, scenario string) (int, int, string) {
+	t.Helper()
+	var input *node
+	tt := coreNewTester(func(c *context) {
+		if multiline {
+			input = coreTextArea(c, &value).Width(300).Height(80)
+		} else {
+			input = coreTextInput(c, &value).Width(300).Height(80)
+		}
+	}, 400, 120)
+	x1, y1 := input.st.x+10, input.st.y+12
+	x2, y2 := input.st.x+160, input.st.y+12
+	if multiline {
+		ed := input.st.editor
+		if ed == nil || ed.area == nil {
+			t.Fatal("multiline area missing")
+		}
+		// The second paragraph's top from the actual text area layout, not a
+		// guessed pixel offset.
+		y2 = input.st.y + float32(ed.area.hs.top(1)) + 12
+		x2 = input.st.x + 30
+	}
+	if reverse {
+		x1, y1, x2, y2 = x2, y2, x1, y1
+	}
+	down := platform.SurfaceEvent{Kind: platform.PointerDown, X: float64(x1), Y: float64(y1)}
+	move := platform.SurfaceEvent{Kind: platform.PointerMove, X: float64(x2), Y: float64(y2)}
+	up := platform.SurfaceEvent{Kind: platform.PointerUp, X: float64(x2), Y: float64(y2)}
+	settle := func() { tt.settle() }
+	switch scenario {
+	case "same-batch":
+		tt.rt.event(down)
+		tt.rt.event(move)
+		tt.rt.event(up)
+	case "down-frame":
+		tt.rt.event(down)
+		settle()
+		tt.rt.event(move)
+		tt.rt.event(up)
+	case "down-move-frame":
+		tt.rt.event(down)
+		tt.rt.event(move)
+		settle()
+		tt.rt.event(up)
+	case "all-frames":
+		tt.rt.event(down)
+		settle()
+		tt.rt.event(move)
+		settle()
+		tt.rt.event(up)
+	default:
+		t.Fatalf("unknown scenario %q", scenario)
+	}
+	settle()
+	if input.st == nil || input.st.editor == nil {
+		t.Fatal("editor state missing")
+	}
+	ed := input.st.editor
+	runes := []rune(value)
+	start, end := min(ed.anchor, ed.caret), max(ed.anchor, ed.caret)
+	if start < 0 || end > len(runes) {
+		t.Fatalf("selection offsets %d..%d outside %d runes", start, end, len(runes))
+	}
+	return ed.anchor, ed.caret, string(runes[start:end])
+}
