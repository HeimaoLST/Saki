+package ui
+
+import (
+	"testing"
+
+	"github.com/egoist/mygo/internal/platform"
+)
+
+func TestSplitReleaseBeforeFrame(t *testing.T) {
+	newSplit := func(size *float32, vertical bool) *Tester {
+		if vertical {
+			return coreNewTester(func(c *context) {
+				coreSplitVertical(c, size, func() { coreText(c, "top") }, func() { coreText(c, "bottom") }).Fill()
+			}, 300, 200)
+		}
+		return coreNewTester(func(c *context) {
+			coreSplit(c, size, func() { coreText(c, "left") }, func() { coreText(c, "right") }).Fill()
+		}, 400, 200)
+	}
+	t.Run("same-batch-release", func(t *testing.T) {
+		size := float32(120)
+		tt := newSplit(&size, false)
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerDown, X: 123, Y: 100})
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerMove, X: 173, Y: 100})
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerUp, X: 173, Y: 100})
+		tt.settle()
+		if size != 170 {
+			t.Fatalf("same-batch split=%v, want 170", size)
+		}
+		tt.settle()
+		if size != 170 {
+			t.Fatalf("empty frame repeated split move: %v", size)
+		}
+	})
+	t.Run("held-multiple-moves", func(t *testing.T) {
+		size := float32(120)
+		tt := newSplit(&size, false)
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerDown, X: 123, Y: 100})
+		tt.settle()
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerMove, X: 143, Y: 100})
+		tt.settle()
+		if size != 140 {
+			t.Fatalf("first held move=%v, want 140", size)
+		}
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerMove, X: 173, Y: 100})
+		tt.settle()
+		if size != 170 {
+			t.Fatalf("second held move=%v, want 170", size)
+		}
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerUp, X: 173, Y: 100})
+		tt.settle()
+		tt.settle()
+		if size != 170 {
+			t.Fatalf("release/empty frame repeated held move: %v", size)
+		}
+	})
+	t.Run("rtl-same-batch", func(t *testing.T) {
+		size := float32(100)
+		tt := newSplit(&size, false)
+		tt.SetDirection(RightToLeft)
+		// First pane is on the right; its left divider is at x=400-100.
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerDown, X: 300, Y: 100})
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerMove, X: 270, Y: 100})
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerUp, X: 270, Y: 100})
+		tt.settle()
+		if size != 130 {
+			t.Fatalf("RTL same-batch split=%v, want 130", size)
+		}
+	})
+	t.Run("vertical-same-batch", func(t *testing.T) {
+		size := float32(60)
+		tt := newSplit(&size, true)
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerDown, X: 100, Y: 61})
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerMove, X: 100, Y: 101})
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerUp, X: 100, Y: 101})
+		tt.settle()
+		if size != 100 {
+			t.Fatalf("vertical same-batch split=%v, want 100", size)
+		}
+	})
+	t.Run("down-alone-move-up-same", func(t *testing.T) {
+		size := float32(120)
+		tt := newSplit(&size, false)
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerDown, X: 123, Y: 100})
+		tt.settle()
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerMove, X: 173, Y: 100})
+		tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerUp, X: 173, Y: 100})
+		tt.settle()
+		if size != 170 {
+			t.Fatalf("down-alone + move/up-same split=%v, want 170", size)
+		}
+	})
+	t.Run("click-keyboard", func(t *testing.T) {
+		size := float32(120)
+		tt := newSplit(&size, false)
+		tt.ClickAt(123, 100)
+		tt.Key(0, KeyRight)
+		if size != 130 {
+			t.Fatalf("click/keyboard split=%v, want 130", size)
+		}
+		tt.Key(0, KeyLeft)
+		if size != 120 {
+			t.Fatalf("click/keyboard return split=%v, want 120", size)
+		}
+	})
+
+}
